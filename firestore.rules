rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Galeri publik: siapa saja boleh baca, hanya login yang boleh tulis.
    match /photos/{photoId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['imageUrl', 'caption', 'takenAt', 'album'])
        && request.resource.data.imageUrl is string
        && request.resource.data.caption is string;
      allow update, delete: if request.auth != null;
    }
    match /timeline_events/{eventId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['date', 'title', 'order'])
        && request.resource.data.title is string;
      allow update, delete: if request.auth != null;
    }
  }
}
